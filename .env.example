# Copy this file to .env (never commit .env).
#
# Groq's free API is the default. Get a key at https://console.groq.com (no credit card).
# When LLM_API_KEY is set here, Folio uses it for every request and hides the key
# field in the UI. Anyone who can open your Folio then uses YOUR Groq quota.
# Leave it unset to have each visitor paste their own key under Advanced.
LLM_API_KEY=your_groq_api_key_here

# Optional: default model (must exist on your account) and a cheaper model for
# rewriting follow-up questions.
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FAST_MODEL=llama-3.1-8b-instant

# To run a LOCAL model with Ollama instead (fully offline), use:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# Optional: the name row at the bottom of the sidebar.
# FOLIO_USER_NAME=Your name
# FOLIO_USER_INITIAL=Y
